# -----------------------------------------------------------------------------
# LindFi Contracts — .env.example
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` to git — it is listed in `.gitignore`.
# -----------------------------------------------------------------------------

# --- RPCs -----------------------------------------------------------------
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC=https://arb1.arbitrum.io/rpc

# --- Deployer -------------------------------------------------------------
# Private key of the deployer wallet (pays gas). This is NOT the Safe.
# The Safe address is a constant in `src/Constants.sol`.
DEPLOYER_PRIVATE_KEY=

# --- Guardrail confirmation ----------------------------------------------
# This value must equal `Constants.expectedSafeFor(block.chainid)` for the
# target network. It is checked before every deploy — see
# DEPLOY_GUARDRAIL_SPEC.md for the enforcement pattern.
#
# For Arbitrum Sepolia (chainid 421614):
EXPECTED_SAFE_ADDRESS=0x87039DF20338A876FB3b4dbd787816D42eecbACa

# --- Verification --------------------------------------------------------
ARBISCAN_API_KEY=
